{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "codex-taskboard",
  "main": "cloud/src/index.mjs",
  "compatibility_date": "2026-07-24",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "codex-taskboard-db",
      "database_id": "a5a1e01b-a92e-4919-bfe5-9aec44edd427",
      "migrations_dir": "cloud/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "codex-taskboard-attachments"
    }
  ]
}
